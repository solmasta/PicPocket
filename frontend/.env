# Development environment variables
# Copy this file to .env.local and add your actual credentials

# Google OAuth Credentials (from Google Cloud Console)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here

# OneDrive (from Azure Portal > App registrations)
REACT_APP_ONEDRIVE_CLIENT_ID=your_onedrive_client_id_here

# Dropbox (from the Dropbox App Console)
REACT_APP_DROPBOX_CLIENT_ID=your_dropbox_client_id_here

# API URL (optional, defaults to /api via proxy)
REACT_APP_API_URL=http://localhost:5000/api