{
  "name": "pic-pocket-frontend",
  "version": "1.4.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@react-oauth/google": "^0.12.1",
    "axios": "^1.6.0",
    "gh-pages": "^6.1.1",
    "idb": "^8.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "uuid": "^9.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-app-rewired build",
    "build:analyze": "ANALYZE=true react-app-rewired build",
    "analyze": "npm run build:analyze && open build/bundle-report.html",
    "test": "react-scripts test",
    "test:vitest": "vitest run",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "build:stats": "react-app-rewired build --stats && npx webpack-bundle-analyzer build/static/js/*.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000",
  "devDependencies": {
    "@testing-library/react": "^13.4.0",
    "compression-webpack-plugin": "^10.0.0",
    "customize-cra": "^1.0.0",
    "jsdom": "^24.0.0",
    "react-app-rewired": "^2.2.1",
    "vitest": "^1.6.0",
    "webpack-bundle-analyzer": "^4.9.0"
  }
}