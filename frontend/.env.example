# Google OAuth Credentials (from Google Cloud Console)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here

# OneDrive (from Azure Portal > App registrations — register a "single-page
# application" with redirect URI set to your app's origin, e.g.
# http://localhost:3000/, and add the Files.ReadWrite.AppFolder + User.Read
# delegated permissions). Optional — leaves the OneDrive connection in
# Settings showing "Not set up yet" until this is set.
REACT_APP_ONEDRIVE_CLIENT_ID=your_onedrive_client_id_here

# Dropbox (from the Dropbox App Console — create a "Scoped access" app,
# add the redirect URI for your app's origin, e.g. http://localhost:3000/,
# and enable the "implicit grant" OAuth flow). Optional — leaves the
# Dropbox connection in Settings showing "Not set up yet" until this is set.
REACT_APP_DROPBOX_CLIENT_ID=your_dropbox_client_id_here

# API URL (optional, defaults to /api via proxy)
REACT_APP_API_URL=
