{
  "name": "picpocket-deployment",
  "version": "1.0.0",
  "description": "PicPocket deployment automation",
  "scripts": {
    "deploy": "chmod +x deploy.sh && ./deploy.sh",
    "deploy-frontend": "cd frontend && npm run deploy",
    "deploy-backend": "cd backend && wrangler deploy",
    "build": "node --check worker.js",
    "build:frontend": "cd frontend && npm ci --legacy-peer-deps && npm run build",
    "test": "cd frontend && npm test"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "itty-router": "^4.2.2",
    "itty-router-extras": "^0.4.6"
  }
}
